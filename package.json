{
  "name": "pika",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:server": "bun --filter=server run dev",
    "dev:web": "bun --filter=web run dev",
    "check": "run-p -n --aggregate-output check:*",
    "check:bun-plugins": "bun --filter=@pika/bun-plugins run check",
    "check:elysia-common": "bun --filter=@pika/elysia-common run check",
    "check:elysia-hook": "bun --filter=@pika/elysia-hook run check",
    "check:elysia-openapi": "bun --filter=@pika/elysia-openapi run check",
    "check:elysia-plugins": "bun --filter=@pika/elysia-plugins run check",
    "check:rate-limit": "bun --filter=@pika/rate-limit run check",
    "check:shared": "bun --filter=@pika/shared run check",
    "check:wrap-naive-ui": "bun --filter=@pika/wrap-naive-ui run check",
    "check:server": "bun --filter=server run check",
    "check:web": "bun --filter=web run check",
    "lint": "run-p lint:*",
    "lint:bun-plugins": "bun --filter=@pika/bun-plugins run lint",
    "lint:elysia-common": "bun --filter=@pika/elysia-common run lint",
    "lint:elysia-hook": "bun --filter=@pika/elysia-hook run lint",
    "lint:elysia-openapi": "bun --filter=@pika/elysia-openapi run lint",
    "lint:elysia-plugins": "bun --filter=@pika/elysia-plugins run lint",
    "lint:rate-limit": "bun --filter=@pika/rate-limit run lint",
    "lint:shared": "bun --filter=@pika/shared run lint",
    "lint:wrap-naive-ui": "bun --filter=@pika/wrap-naive-ui run lint",
    "lint:server": "bun --filter=server run lint",
    "lint:web": "bun --filter=web run lint",
    "build": "run-s build:web build:server",
    "build:server": "bun --filter=server run build",
    "build:web": "bun --filter=web run build",
    "test": "run-p -n --aggregate-output test:*",
    "test:server": "bun --cwd=apps/server test",
    "test:elysia-common": "bun --cwd=packages/elysia-common test",
    "test:elysia-plugins": "bun --cwd=packages/elysia-plugins test",
    "db:gen": "bun --filter=server run db:gen",
    "db:kit": "bun --filter=server run db:kit",
    "postinstall": "git-hooks --force",
    "lint-staged": "lint-staged",
    "release": "run-s check test && commit-and-tag-version",
    "release-beta": "run-s check test && commit-and-tag-version --prerelease beta"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "bun-git-hooks": "^0.3.3",
    "commit-and-tag-version": "^13.1.2",
    "lint-staged": "^17.3.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite-plugin-compression2": "^2.5.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "git-hooks": {
    "commit-msg": "bunx commitlint --edit \"$1\"",
    "pre-commit": "bun lint-staged"
  }
}
