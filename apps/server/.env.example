# 可复制本文件为 .env.local 进行本地开发测试

# ───────────────────────────────────────
# 服务配置
# ───────────────────────────────────────
PORT=9528
LOG_LEVEL=info                     # debug/info/warn/error
# LOG_PATH=~/.pika/logs/server.log # 日志文件路径，未配置时仅输出到控制台
REQUEST_IDLE_TIMEOUT=120
REQUEST_MAX_BODY_SIZE=268435456    # 256MB
MULTI_PROCESS_MODE_ENABLED=false   # true/false, bun和node一样为单进程，当开启且为postgresql+redis，支持启用为多进程模式
ADMIN_EMAIL=admin@example.com      # 管理员邮箱，当注册的用户邮箱与管理员一致，将有管理后台权限
# CORS_ORIGINS=https://pika.example.com,https://admin.example.com # 允许跨域访问的来源，不配置时放行所有来源
# OPENAPI_ENABLED=false              # 前端 src/api 的类型由 OpenAPI 自动生成，本地开发默认开启，生产默认关闭

# ───────────────────────────────────────
# JWT 配置 
# ───────────────────────────────────────
# ⚠️ 务必修改 JWT_SECRET 值（如`openssl rand -hex 32` 生成）
JWT_SECRET=?
JWT_ISSUER=pika
JWT_EXPIRES=1h
JWT_REFRESH_EXPIRES=48h

# ───────────────────────────────────────
# Cache
#   CACHE_URL 为 redis/valkey 连接串时使用 Redis 缓存（二者协议互通）
#   为 memory 时使用内存缓存
#   为其他非空值时视为文件缓存目录
#   未配置或留空时使用默认文件缓存目录（开发 .tmp/.cache，生产 ~/.pika/data/.cache）
# ───────────────────────────────────────
# CACHE_URL=redis://localhost:6379/0
# CACHE_URL=memory
# CACHE_URL=~/.pika/data/.cache

# ───────────────────────────────────────
# 数据库
#   未配置或留空时使用默认文件缓存目录（开发 .tmp/.pglite.data，生产 ~/.pika/data/.pglite.data）
# ───────────────────────────────────────
# DATABASE_URL=postgresql://user:pwd@127.0.0.1:5432/db_name
# DATABASE_URL=~/.pika/data/.pglite.data

# ───────────────────────────────────────
# 文件存储
#   未启用 OSS 时的本地存储目录
#   未配置或留空时使用默认文件缓存目录（开发 .tmp/.file，生产 ~/.pika/data/.file）
# ───────────────────────────────────────
# FILE_PATH=~/.pika/data/.file

# ───────────────────────────────────────
# 其他
# ───────────────────────────────────────
# GAVATAR_BASE_URL=https://gravatar.com # 默认头像服务地址
# SNOWFLAKE_WORKER_ID_BIT_LENGTH=10     # 雪花 ID 机器码位长，与序列数位长之和不超过 22
# SNOWFLAKE_SEQ_BIT_LENGTH=10           # 雪花 ID 序列数位长，与机器码位长之和不超过 22
