    "alova": "^3.5.5",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.51.0",
    "go-captcha-vue": "^2.0.7",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.519",
